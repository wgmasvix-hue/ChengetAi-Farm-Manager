# Copy this file to .env and adjust the values before running
# `docker compose up -d --build`.

# PostgreSQL credentials. Set a strong POSTGRES_PASSWORD — the stack
# refuses to start while it is empty.
POSTGRES_USER=farm
POSTGRES_PASSWORD=
POSTGRES_DB=farm

# Host port the web server is published on.
WWW_PORT=80

# Repository and branch the farmOS codebase is built from.
FARMOS_REPO=https://github.com/wgmasvix-hue/ChengetAi-Farm-Manager.git
FARMOS_VERSION=4.x
