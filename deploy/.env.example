# Copy this file to .env (in the deploy directory) and edit the values.

# REQUIRED: a strong password for the PostgreSQL database.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Email address used for Let's Encrypt certificate registration.
ACME_EMAIL=admin@chengetailabs.co.zw

# Branch or tag of the ChengetAi-Farm-Manager fork to build the image from.
FARMOS_VERSION=4.x
