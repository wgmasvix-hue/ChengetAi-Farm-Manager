# Copy this file to .env and adjust the values before running
# `docker compose up -d --build`.

# PostgreSQL credentials. Set a strong POSTGRES_PASSWORD — the stack
# refuses to start while it is empty.
POSTGRES_USER=farm
POSTGRES_PASSWORD=
POSTGRES_DB=farm

# Public domain name for the site. When set, the proxy obtains a free
# Let's Encrypt certificate automatically and serves the site over HTTPS
# (HTTP is redirected). The domain's DNS A record must point at this
# server's IP before starting. Leave unset to serve plain HTTP on port 80.
#FARM_DOMAIN=farm.example.com

# Repository and branch the farmOS codebase is built from.
FARMOS_REPO=https://github.com/wgmasvix-hue/ChengetAi-Farm-Manager.git
FARMOS_VERSION=4.x
